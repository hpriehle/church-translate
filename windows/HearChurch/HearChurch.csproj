<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app's native shell (W2): WinUI 3, unpackaged and self-contained, x64, Windows 10 1809+ and 11.
       It starts the engine sidecar (engine\hearchurch-engine.exe, windows/build.py) and drives it: docs/windows-app.md. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>HearChurch</RootNamespace>
    <AssemblyName>HearChurch</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\HearChurch.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- CI passes the release's version and build (-p:Version=… -p:FileVersion=…): docs/windows-release.md. -->
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.1</FileVersion>
    <AssemblyVersion>0.1.0.1</AssemblyVersion>
    <Product>Hear Church</Product>
    <Company>Hear Church</Company>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- Program.cs has Main, so Velopack's hooks run before WinUI starts (docs/windows-release.md). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\HearChurch.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
