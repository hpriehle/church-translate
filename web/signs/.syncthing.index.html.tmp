<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Signs — headphones for live translation</title>
<style>
  @page { size: letter landscape; margin: 0.5in; }
  body { margin: 0; font-family: -apple-system, system-ui, "Segoe UI", sans-serif; color: #111; background: #eee; }
  .sheet { background: #fff; width: 10in; height: 7.5in; margin: 0.3in auto; box-sizing: border-box; padding: 0.6in 0.7in;
           display: flex; flex-direction: column; justify-content: center; page-break-after: always; break-after: page; }
  .sheet:last-child { page-break-after: auto; break-after: auto; }
  .icon { width: 1.3in; height: 1.3in; margin: 0 auto 0.35in; }
  .icon svg { width: 100%; height: 100%; fill: none; stroke: #111; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .line { text-align: center; margin: 0.12in 0; }
  .fr { font-size: 40pt; font-weight: 750; line-height: 1.15; }
  .wo { font-size: 34pt; font-weight: 650; line-height: 1.15; }
  .en { font-size: 22pt; color: #444; margin-top: 0.3in; }
  .rule { width: 2.5in; border-top: 2px solid #ccc; margin: 0.25in auto; }
  .hint { text-align: center; color: #666; font-size: 11pt; margin-top: 0.4in; }
  @media print { body { background: #fff; } .sheet { margin: 0; box-shadow: none; } .noprint { display: none; } }
  .noprint { text-align: center; padding: .6rem; font-size: 14px; }
  .noprint button { font: inherit; padding: .4rem 1rem; }
</style>
</head>
<body>
<div class="noprint"><button onclick="window.print()">Print both signs</button>
  · One sign per page (landscape). Please have a Wolof speaker check the Wolof before printing.</div>

<div class="sheet">
  <div class="icon"><svg viewBox="0 0 24 24"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="2.5" y="14" width="4" height="6.5" rx="1.5"/><rect x="17.5" y="14" width="4" height="6.5" rx="1.5"/></svg></div>
  <div class="line fr">Casques pour la traduction simultanée en français</div>
  <div class="rule"></div>
  <div class="line wo">Kask yi ngir déglu tekki ci farañse ci saa si</div>
  <div class="line en">Headphones for live French translation</div>
</div>

<div class="sheet">
  <div class="icon"><svg viewBox="0 0 24 24"><path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="2.5" y="14" width="4" height="6.5" rx="1.5"/><rect x="17.5" y="14" width="4" height="6.5" rx="1.5"/></svg></div>
  <div class="line wo">Kask yi ngir déglu tekki ci wolof ci saa si</div>
  <div class="rule"></div>
  <div class="line fr">Casques pour la traduction simultanée en wolof</div>
  <div class="line en">Headphones for live Wolof translation</div>
</div>
</body>
</html>
