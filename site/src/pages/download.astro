---
// The download page. On a Mac it checks which chip it has and offers that build; on a Windows PC, the form to
// request the Windows app, which is in beta (we email the installer link, /download/HearChurch-Setup.exe, to churches
// that ask; download/src/windows-beta.js). The other builds are linked below.
import Base from "../layouts/Base.astro";
---
<Base
  title="Download Hear Church for Mac and Windows | Hear Church"
  description="Download Hear Church, the free app that translates your church meeting live. For Macs with Apple silicon or Intel, and Windows 10 and 11 PCs.">

  <section class="dl wrap" data-dl>
    <img class="icon" src="/download/icon.png" width="1024" height="1024" alt="The Hear Church app icon: a pulpit with a microphone and a sound wave on it">

    <div class="copy">
      <h1>Download Hear Church</h1>
      <p class="found" data-found aria-live="polite">The free app that translates your church meeting live, for Mac and Windows.</p>
      <a class="get" href="/download/HearChurch.dmg" data-cta="download" data-get>Download for Mac with Apple silicon</a>
      <p class="other" data-other="arm">Have an Intel Mac? <a href="/download/HearChurch-Intel.dmg" data-cta="download-intel">Download the Intel version</a></p>
      <p class="other" data-other="intel" hidden>Have a Mac with Apple silicon? <a href="/download/HearChurch.dmg" data-cta="download">Download that version</a></p>
      <p class="other" data-unsure hidden>Not sure which you have? Open the Apple menu and choose About This Mac.
        If it lists a Chip, your Mac has Apple silicon. If it lists a Processor, it's an Intel Mac.</p>
      <p class="other" data-other="win">Using a Windows PC? <a href="#windows-beta" data-cta="windows-beta">Request the Windows app (beta)</a></p>
      <p class="other" data-other="mac" hidden>Using a Mac? Download the <a href="/download/HearChurch.dmg" data-cta="download">Apple silicon version</a> or the <a href="/download/HearChurch-Intel.dmg" data-cta="download-intel">Intel version</a></p>
    </div>
  </section>

  <section class="beta wrap" id="windows-beta" aria-labelledby="beta-h" data-beta>
    <h2 id="beta-h">Request the Windows app (beta)</h2>
    <div data-ask>
      <p>The Windows app is in beta. Tell us about your church and we'll send you the download and help you set it up.
        It needs Windows 10 (version 1809 or newer) or Windows 11 on a 64-bit PC. No graphics card needed.</p>
      <form method="post" action="/api/windows-beta">
        <label>Your name <input name="name" autocomplete="name" maxlength="100" required></label>
        <label>Church <input name="church" autocomplete="organization" maxlength="120" required></label>
        <label>Email <input name="email" type="email" autocomplete="email" maxlength="200" required></label>
        <label>Church or your phone <input name="phone" type="tel" autocomplete="tel" maxlength="20" required></label>
        <label>City and state <input name="city" autocomplete="address-level2" maxlength="60"></label>
        <label>Languages your members need <input name="languages" maxlength="200" placeholder="For example Spanish, Tongan"></label>
        <label>Windows version (optional)
          <select name="windows"><option value="">Not sure</option><option>11</option><option>10</option></select></label>
        <label>Anything else <textarea name="message" rows="3" maxlength="2000"></textarea></label>
        <!-- Spam guard: hidden from people, filled in by bots. -->
        <label class="trap" aria-hidden="true">Website <input name="website" tabindex="-1" autocomplete="off"></label>
        <button class="get" type="submit" data-cta="windows-beta-send">Request the Windows app</button>
      </form>
    </div>
    <p class="found" data-thanks hidden>Thank you. We got your request and will email you the download and help you
      set it up.</p>
  </section>
</Base>

<script>
  // Apple silicon or Intel? Every Mac browser says "Intel Mac OS X", so look at the graphics chip
  // (Chrome, Edge, Firefox), then Chrome's architecture hint. Safari hides both: there we offer the
  // Apple silicon build, which every Mac sold since 2023 needs, and say how to check.
  async function whichMac() {
    try {
      const gl = document.createElement("canvas").getContext("webgl")!;
      const info = gl.getExtension("WEBGL_debug_renderer_info");
      const gpu = String(gl.getParameter(info ? info.UNMASKED_RENDERER_WEBGL : gl.RENDERER));
      gl.getExtension("WEBGL_lose_context")?.loseContext();
      if (/Apple M\d/.test(gpu)) return "arm";
      if (/Intel|AMD|Radeon|NVIDIA/i.test(gpu)) return "intel";
    } catch {}
    try {
      const { architecture } = await (navigator as any).userAgentData.getHighEntropyValues(["architecture"]);
      if (architecture === "arm") return "arm";
      if (architecture === "x86") return "intel";
    } catch {}
    return "";
  }

  const box = document.querySelector<HTMLElement>("[data-dl]")!;
  const $ = <T extends HTMLElement>(sel: string) => box.querySelector<T>(sel)!;
  const found = $("[data-found]"), get = $<HTMLAnchorElement>("[data-get]");
  const ua = navigator.userAgent;
  const phone = /iPhone|iPod|iPad|Android/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);

  if (phone) {
    found.textContent = "Hear Church runs on a Mac or a Windows PC. Open this page on the computer you'll use at church to download it.";
  } else if (/Windows NT/.test(ua)) {
    document.documentElement.dataset.os = "windows";
    found.textContent = "This is a Windows PC. The Windows app is in beta: fill in the form below and we'll send it to you.";
    get.hidden = true;
    for (const p of box.querySelectorAll<HTMLElement>("[data-other], [data-unsure]")) p.hidden = true;
    $('[data-other="mac"]').hidden = false;
  } else {
    whichMac().then((chip) => {
      document.documentElement.dataset.mac = chip || "unknown";
      if (chip === "intel") {
        found.textContent = "This is an Intel Mac, so this is the version you need.";
        get.href = "/download/HearChurch-Intel.dmg";
        get.dataset.cta = "download-intel";
        get.textContent = "Download for Intel Mac";
        $('[data-other="arm"]').hidden = true;
        $('[data-other="intel"]').hidden = false;
      } else if (chip === "arm") {
        found.textContent = "This Mac has Apple silicon, so this is the version you need.";
      } else {
        found.textContent = "Your browser doesn't say which chip this Mac has. Most Macs need the Apple silicon version.";
        $("[data-unsure]").hidden = false;
      }
    });
  }
</script>

<script>
  // The request form shows for Windows PCs and for anyone sent to #windows-beta; a Mac visitor sees only the download.
  const beta = document.querySelector<HTMLElement>("[data-beta]")!;
  const requested = new URLSearchParams(location.search).has("requested");
  const showBeta = () => {
    beta.hidden = !(requested || location.hash === "#windows-beta" || /Windows NT/.test(navigator.userAgent));
  };
  showBeta();
  addEventListener("hashchange", showBeta);
  if (requested) {
    beta.querySelector<HTMLElement>("[data-ask]")!.hidden = true;
    beta.querySelector<HTMLElement>("[data-thanks]")!.hidden = false;
  }
</script>

<style>
/* This page is short: fill the window so the footer sits at its bottom edge, and follows the content when the
   window is shorter than the page. Only here; the layout's other pages keep their plain block body. */
:global(body) { display: flex; flex-direction: column; min-height: 100vh; min-height: 100dvh; }
:global(body > main) { flex: 1 0 auto; }
:global(body > .top), :global(body > .foot) { width: 100%; }

/* The app icon on the left, the button for this Mac on the right. */
.dl {
  display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center;
  gap: 2.5rem clamp(3rem, 7vw, 6rem); max-width: 56rem;
  padding-top: clamp(3rem, 10vh, 6.5rem); padding-bottom: clamp(4rem, 14vh, 8rem);
}
.copy h1 { margin-bottom: .9rem; }
.copy .get { text-wrap: balance; }
.found { font-size: 1.25rem; margin: 0 0 1.75rem; max-width: 30rem; text-wrap: pretty; }
.other { color: var(--quiet); font-size: 1rem; margin: 1rem 0 0; max-width: 30rem; text-wrap: pretty; }
.other[hidden] { display: none; }

/* The Windows beta request form. */
.beta { max-width: 40rem; padding-bottom: clamp(3rem, 10vh, 6rem); }
.beta[hidden], .beta [hidden], .get[hidden] { display: none; }
.beta form { display: grid; gap: 1rem; margin-top: 1.5rem; }
.beta label { display: grid; gap: .3rem; font-weight: 700; }
.beta input, .beta select, .beta textarea { font: inherit; font-weight: 400; padding: .55rem .7rem; border: 1px solid var(--quiet); border-radius: .4rem; }
.beta button { justify-self: start; border: 0; cursor: pointer; font: inherit; }
.beta .trap { position: absolute; left: -100vw; }

/* The app icon, the way it sits in the Dock. */
.icon { width: clamp(11rem, 24vw, 16rem); height: auto; margin: 0 -.5rem; filter: drop-shadow(0 1.1rem 1.6rem rgb(0 0 0 / .32)); }

@media (max-width: 44rem) {
  .dl { grid-template-columns: 1fr; padding-top: 2.5rem; }
  .icon { width: 8.5rem; }
}
</style>
