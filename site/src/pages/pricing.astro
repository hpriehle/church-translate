---
// /pricing: one free language-hour every month, then prepaid bundles (decided 2026-11-14).
// Every number here must match the billing code (app/hear/db.py BUNDLES, FREE_SECONDS) and download/src/terms.html
// ("Credits and refunds"): 1 free language-hour per calendar month (UTC), no carry-over, unlimited listeners;
// bundles $20 = 4 h, $50 = 11 h, $100 = 25 h, $250 = 70 h; hours never expire; unused hours refundable anytime,
// pro rata at the bundle's price; sold by Automaddie LLC. Free trial (decided 2026-11-16; db.py TRIAL_DAYS,
// TRIAL_SECONDS): every new church gets 14 days free from its first meeting, up to 20 language-hours, whichever ends
// first; the monthly free hour starts after it; own-key congregations get none. Deploying site/ publishes it.
import Base from "../layouts/Base.astro";

const BUNDLES = [ // [US dollars, language-hours]
  [20, 4],
  [50, 11],
  [100, 25],
  [250, 70],
];
const perHour = (usd, hours) => "$" + (usd / hours).toFixed(2);

const faq = [
  ["What does a typical meeting cost?",
   "A 70-minute meeting usually has about 50 minutes of speaking. Heard in two languages, that is 100 language-minutes, about 1.7 language-hours: between $6 and $8.33 depending on the bundle. In one language, half that. After your free trial, your free hour each month covers the first hour."],
  ["Is there a free trial?",
   "Every new church starts with 14 days free, up to 20 language-hours. After that, one free language-hour each month, then prepaid hours from $5 per language-hour. The 14 days start with your first translated meeting, and the trial ends after 14 days or 20 language-hours, whichever comes first. No card is needed."],
  ["What is a language-hour?",
   "One hour of speech translated into one language that someone is listening to. An hour heard in two languages is two language-hours. A language nobody is following that day costs nothing."],
  ["How does the free hour work?",
   "Every congregation gets one free language-hour each calendar month, starting once its free trial has ended. It is used first, before any hours you bought, and it renews on the 1st. Free time you don't use doesn't carry over to the next month."],
  ["Do listeners pay anything?",
   "No. Listeners open your congregation's link or scan its QR code. They have nothing to install, no account and nothing to pay, and there is no limit on how many can listen."],
  ["Is there a monthly plan or contract?",
   "No. Beyond the free trial and the free hour you buy a bundle of hours in advance and use it as you go. Hours you bought never expire, so you only pay for meetings you translate."],
  ["What if we run out during a meeting?",
   "Translation carries on to the end, so your balance can dip below zero. The next bundle pays for that time first, and a new meeting starts once there are hours left again, or when next month's free hour arrives."],
  ["Can we get our money back?",
   "Yes. Ask for a refund of unused hours at any time by emailing support@hearchurch.com. Each bundle is refunded at its own price per hour: if 5.5 of the 11 hours of a $50 bundle are unused, you get $25 back. Hours already used for translation aren't refundable."],
];

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
};
---
<Base
  title="Church Translation Pricing: a Free Hour Every Month | Hear Church"
  description="Hear Church pricing: one free language-hour every month with unlimited listeners, then prepaid bundles from $20 for 4 hours to $250 for 70 hours. Silence isn't billed. No monthly plan."
  schema={schema}>
  <article class="wrap">
    <header class="head">
      <h1>Church translation pricing</h1>
      <p class="lede">Pay only for the time someone is speaking, in each language your members are listening to. Every new church starts with 14 days free, up to 20 language-hours. After that, one free language-hour each month, then prepaid hours from $5 per language-hour.</p>
    </header>

    <section class="plans" aria-label="Plans">
      <div class="plan">
        <h2>Free</h2>
        <p class="price"><span class="amount">$0</span></p>
        <p class="unit">14 days to start, then 1 hour every month, unlimited listeners</p>
        <p class="sum">Every new church starts with 14 days free, up to 20 language-hours. After that, every congregation gets one free language-hour each calendar month. Try it on a real Sunday before you buy anything.</p>
        <ul>
          <li>14 days free to start, up to 20 language-hours, no card</li>
          <li>Live captions and spoken translation</li>
          <li>Unlimited listeners, who never pay</li>
          <li>Renews on the 1st of every month</li>
          <li>Unused free time doesn't carry over</li>
        </ul>
        <a class="btn" href="/start">Get started</a>
      </div>

      <div class="plan main">
        <p class="tag">When you need more</p>
        <h2>Hour bundles</h2>
        <p class="unit">Prepaid language-hours, cheaper per hour as the bundle grows. Buy in the app or in your account.</p>
        <table class="bundles">
          <thead><tr><th scope="col">Bundle</th><th scope="col">Hours</th><th scope="col">Per hour</th></tr></thead>
          <tbody>
            {BUNDLES.map(([usd, hours]) => (
              <tr><td class="b-usd">${usd}</td><td>{hours} hours</td><td class="b-rate">{perHour(usd, hours)}</td></tr>
            ))}
          </tbody>
        </table>
        <ul>
          <li><b>Hours never expire</b></li>
          <li><b>Refund unused hours anytime</b></li>
          <li>No monthly plan, no contract</li>
          <li>A meeting is never cut off</li>
        </ul>
        <a class="btn get" href="/start">Start with 14 days free</a>
      </div>
    </section>

    <section class="calc" aria-labelledby="calc-h">
      <h2 id="calc-h">Estimate a month</h2>
      <form id="calc" class="calc-form" onsubmit="return false">
        <label>Minutes of speaking
          <input id="c-min" type="number" inputmode="numeric" min="0" max="600" step="5" value="50">
          <small>A 70-minute meeting has about 50.</small>
        </label>
        <label>Languages heard
          <input id="c-lang" type="number" inputmode="numeric" min="1" max="20" step="1" value="2">
          <small>Not counting the one being spoken.</small>
        </label>
        <label>Meetings a month
          <input id="c-meet" type="number" inputmode="numeric" min="1" max="60" step="1" value="4">
          <small>Sundays, plus anything else you translate.</small>
        </label>
      </form>
      <div class="calc-out" aria-live="polite">
        <p><span class="big" id="c-month">$25.76</span> a month</p>
        <p class="quiet" id="c-hours">6.7 language-hours a month: 1 free, 5.7 paid.</p>
        <p class="quiet" id="c-bundle">At the $50 bundle's $4.55 an hour. One bundle lasts about 2 months.</p>
      </div>
    </section>

    <section class="counts" aria-labelledby="counts-h">
      <h2 id="counts-h">What counts</h2>
      <div class="cols">
        <div>
          <h3>Counted</h3>
          <ul class="yes">
            <li>Seconds of speech in which Hear Church recognizes words and translates them</li>
            <li>Sung words that Hear Church recognizes and translates</li>
            <li>Each language, while at least one person is following it by voice or captions</li>
          </ul>
        </div>
        <div>
          <h3>Not counted</h3>
          <ul class="no">
            <li>Silence and pauses</li>
            <li>Music and stretches with no recognized words</li>
            <li>Prayers or parts you choose not to translate</li>
            <li>A language nobody is listening to</li>
            <li>Listeners: any number can follow, at no cost</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="prose questions">
      <h2>Questions</h2>
      <dl class="faq">
        {faq.map(([q, a]) => <><dt>{q}</dt><dd>{a}</dd></>)}
      </dl>

      <div class="ctas">
        <a class="get" href="/start">Get started</a>
        <a class="second" href="/download">Download for Mac</a>
      </div>
      <p class="seller quiet">Prices in US dollars. Hours are sold by Automaddie LLC; payments go through Stripe. See the <a href="/terms">terms</a> for the details.</p>
    </section>
  </article>
</Base>

<script define:vars={{ BUNDLES }}>
const $ = (id) => document.getElementById(id);
const usd = (n) => "$" + n.toFixed(2);
const num = (id, lo) => Math.max(lo, Number($(id).value) || 0);
const h1 = (n) => (Math.round(n * 10) / 10).toString();
function update() {
  const month = (num("c-min", 0) / 60) * num("c-lang", 1) * num("c-meet", 1);
  const paid = Math.max(0, month - 1);   // the free hour comes first, every month
  $("c-hours").textContent = `${h1(month)} language-hours a month: ${h1(Math.min(month, 1))} free, ${h1(paid)} paid.`;
  if (paid <= 0) {
    $("c-month").textContent = "$0";
    $("c-bundle").textContent = "Your free hour covers it.";
    return;
  }
  // the smallest bundle that covers a month; past the biggest, the biggest
  const [price, hours] = BUNDLES.find(([, h]) => h >= paid) || BUNDLES[BUNDLES.length - 1];
  const rate = price / hours;
  $("c-month").textContent = usd(paid * rate);
  const lasts = hours / paid;
  $("c-bundle").textContent = `At the $${price} bundle's ${usd(rate)} an hour. `
    + (lasts >= 1.5 ? `One bundle lasts about ${Math.round(lasts)} months.` : lasts >= 1 ? "One bundle lasts about a month." : `About ${Math.ceil(paid / hours)} bundles a month.`);
}
$("calc").addEventListener("input", update);
update();
</script>

<style>
.head { padding: clamp(1.5rem, 5vh, 3rem) 0 1.5rem; max-width: 44rem; }
article { padding-bottom: clamp(3rem, 8vh, 5rem); }
section + section { margin-top: clamp(3rem, 8vh, 4.5rem); }

.plans { display: grid; gap: 1.25rem; align-items: stretch; }
@media (min-width: 46rem) { .plans { grid-template-columns: 1fr 1.12fr; align-items: center; max-width: 52rem; margin-inline: auto; } }
.plan {
  display: flex; flex-direction: column; padding: 1.75rem 1.6rem 1.6rem; border: 1px solid var(--line);
  border-radius: 1.25rem; background: var(--cloth-deep);
}
.plan.main {
  border: 2px solid var(--gold-deep); background: linear-gradient(#173d33, var(--cloth-deep));
  box-shadow: 0 1rem 2.5rem rgb(0 0 0 / .3); padding-block: 2.1rem 2rem;
}
.plan h2 { font-size: 1.6rem; margin: 0 0 .75rem; }
.tag {
  align-self: flex-start; margin: 0 0 .9rem; padding: .2rem .7rem; border-radius: 1rem; font-size: .9rem; font-weight: 700;
  color: var(--ink); background: var(--gold);
}
.price { margin: 0; line-height: 1; }
.bundles { width: 100%; border-collapse: collapse; margin: 0 0 1.25rem; font-variant-numeric: tabular-nums; }
.bundles th { text-align: left; font-size: .9rem; font-weight: 700; color: var(--quiet); padding: 0 0 .4rem; }
.bundles td { padding: .5rem 0; border-top: 1px solid var(--line); }
.bundles .b-usd { font: 600 1.5rem/1 var(--serif); color: var(--gold); }
.bundles .b-rate { color: var(--quiet); }
.amount { font: 600 3.6rem/1 var(--serif); color: var(--gold); }
.unit { margin: .4rem 0 1rem; color: var(--quiet); }
.sum { margin: 0 0 1rem; line-height: 1.5; }
.plan ul { list-style: none; margin: 0 0 1.5rem; padding: 0; flex: 1; }
.plan li { position: relative; padding-left: 1.6rem; margin-bottom: .45rem; line-height: 1.4; }
.plan li::before { content: "✓"; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
.btn {
  display: block; text-align: center; padding: .75rem 1rem; border-radius: .9rem; font-weight: 700; text-decoration: none;
  border: 1px solid var(--gold-deep); color: var(--gold);
}
.btn:hover { background: rgb(244 208 131 / .08); }
.btn.get { font-size: 1.15rem; border: 0; color: var(--ink); }

.calc { display: grid; gap: 1.5rem 3rem; padding: 2rem clamp(1.25rem, 3vw, 2.25rem); border: 1px solid var(--line); border-radius: 1.25rem; }
.calc h2 { margin: 0; }
@media (min-width: 48rem) { .calc { grid-template-columns: 1.4fr 1fr; } .calc h2 { grid-column: 1 / -1; } }
.calc-form { display: grid; gap: 1.1rem; }
@media (min-width: 36rem) { .calc-form { grid-template-columns: repeat(3, 1fr); } }
.calc label { display: flex; flex-direction: column; gap: .35rem; font-weight: 700; }
.calc input {
  font: 600 1.5rem var(--serif); width: 100%; padding: .45rem .7rem; border-radius: .7rem; border: 1px solid var(--line);
  background: var(--cloth-deep); color: var(--paper);
}
.calc input:focus-visible { outline: 3px solid var(--gold); outline-offset: 2px; }
.calc small { font-weight: 400; font-size: .95rem; color: var(--quiet); line-height: 1.35; }
.calc-out { align-self: center; }
.calc-out p { margin: 0 0 .4rem; }
.big { font: 600 2.6rem/1.1 var(--serif); color: var(--gold); margin-right: .3rem; }

.cols { display: grid; gap: 1rem 3rem; }
@media (min-width: 48rem) { .cols { grid-template-columns: 1fr 1fr; } }
.cols h3 { margin-top: 0; }
.counts ul { list-style: none; margin: 0; padding: 0; }
.counts li { position: relative; padding-left: 1.7rem; margin-bottom: .6rem; line-height: 1.45; }
.counts .yes li::before { content: "✓"; position: absolute; left: 0; color: var(--gold); font-weight: 700; }
.counts .no li::before { content: "—"; position: absolute; left: 0; color: var(--quiet); }
.counts h2 { margin-bottom: 1.25rem; }

.seller { margin-top: 2rem; font-size: 1rem; }
</style>
