---
import Base from "../layouts/Base.astro";
import Demo from "../components/Demo.astro";

const schema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: "How to translate a church service live with Hear Church",
  step: [
    { "@type": "HowToStep", name: "Set up the Mac", text: "Install Hear Church on a Mac with Apple silicon, enter your congregation and choose its languages." },
    { "@type": "HowToStep", name: "Connect the sound", text: "Use the Mac's microphone or a cable from the sound system, and check that the Mac hears the speaker." },
    { "@type": "HowToStep", name: "Start the meeting", text: "Press Start meeting. Listeners scan the QR code or open the congregation's link on their phones." },
  ],
};
---
<Base
  title="How Live Church Translation Works | Hear Church"
  description="See how Hear Church works: the speaker talks, a Mac translates, and every listener hears it in their own language on their phone. Hear a sample."
  schema={schema}>

  <section class="wrap top-sec">
    <h1>How it works</h1>
    <p class="lede">A speaker, a Mac and the phones already in people's pockets. Here's one sentence making the trip.</p>
    <Demo />
  </section>

  <section class="wrap band">
    <h2>The three parts</h2>
    <div class="cols">
      <div>
        <h3>The Mac</h3>
        <p class="quiet">Any Mac with Apple silicon and macOS 14 or newer. Setup takes about 5 minutes: your congregation, when you meet, and the languages people need.</p>
        <ul>
          <li>Hears the speaker through its microphone or a cable from the sound system</li>
          <li>Turns speech into text on the Mac itself</li>
          <li>Translates and sends captions and a voice to every listener</li>
        </ul>
      </div>
      <div>
        <h3>The speaker</h3>
        <p class="quiet">Nothing changes at the pulpit. Speak as usual.</p>
        <ul>
          <li>English, French, Spanish or Russian</li>
          <li>The person at the Mac switches the language when a speaker changes</li>
          <li>Music is skipped, so hymns don't fill phones with noise</li>
        </ul>
      </div>
      <div>
        <h3>The listeners</h3>
        <p class="quiet">No app, no account. Just a phone and headphones.</p>
        <ul>
          <li>Scan the QR code or open your congregation's link</li>
          <li>Pick French, Wolof, Spanish or Russian</li>
          <li>Read the captions and hear the voice, a few seconds behind the speaker</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap band">
    <h2>On Sunday</h2>
    <ol class="steps three">
      <li><b>Press Start meeting</b>
        <span>The Mac checks the microphone, the sound, its power and the internet first. If a cable comes loose mid-meeting, it warns you.</span></li>
      <li><b>People join as they sit down</b>
        <span>Before the meeting starts, phones show when it begins and wait. If a connection drops, it comes back by itself.</span></li>
      <li><b>Press Stop when it ends</b>
        <span>A log of the meeting stays on that Mac. Nothing is saved on our server.</span></li>
    </ol>
  </section>

  <section class="wrap band split">
    <div>
      <h2>Get the best results</h2>
      <ul class="tips">
        <li><b>Give it clean sound.</b> A cable from the sound system beats a microphone across the room.</li>
        <li><b>Add your names.</b> Names are where machine translation slips most. Add your congregation's in the app.</li>
        <li><b>Test before people arrive.</b> Say a sentence at the pulpit and check a phone.</li>
      </ul>
    </div>
    <div>
      <h2>Ready for your first Sunday?</h2>
      <p class="quiet">Download the app, set it up this week and try it at your next service.</p>
      <div class="ctas">
        <a class="get" href="/download">Download for Mac</a>
      </div>
      <p class="quiet next">Latter-day Saint ward? Read <a href="/blog/sacrament-meeting-translation">how to translate sacrament meeting live</a>.</p>
    </div>
  </section>

  <p class="wrap credits">Sample voices: French, SIWIS (CC BY 4.0); Spanish, Ald (public domain); Russian, Denis (CC0). All from the Piper voice project. <a href="/credits">Voice credits</a>.</p>
</Base>

<style>
.top-sec { padding-top: clamp(1.25rem, 4vh, 2.5rem); padding-bottom: clamp(3rem, 7vh, 4.5rem); }
.top-sec .lede { max-width: 36rem; margin: 0 0 2rem; }
.cols { display: grid; gap: 2.25rem clamp(2rem, 4vw, 3.5rem); }
.cols h3 { margin-top: 0; color: var(--gold); }
.cols ul, .tips { padding-left: 1.15rem; margin: .8rem 0 0; }
.cols li, .tips li { margin-bottom: .55rem; }
.split { display: grid; gap: 2.5rem clamp(2rem, 5vw, 4rem); }
.next { margin-top: 1.5rem; }
.credits { color: var(--quiet); font-size: .95rem; padding-bottom: 2.5rem; }
@media (min-width: 48rem) { .cols { grid-template-columns: repeat(3, 1fr); } .split { grid-template-columns: 1fr 1fr; } }
</style>
